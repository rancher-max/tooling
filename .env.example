# Jira connection settings
#
# Jira Server / Data Center (e.g. jira.suse.com)
# Uses Bearer PAT auth over REST API v2.
JIRA_BASE_URL=https://jira.suse.com
JIRA_API_TOKEN=your_jira_personal_access_token

# Optional: where extracted files are written (default: ./output)
# JIRA_EXTRACTOR_OUTPUT_DIR=output

# Optional: local Ollama settings for theme analysis
# OLLAMA_ENABLED=true
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434
